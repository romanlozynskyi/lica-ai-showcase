# Optional. Telegram bot that every "Перейти в Telegram" button opens (username without @).
# Without it the buttons open Telegram's official channel as a demo destination.
# NEXT_PUBLIC_TG_BOT=your_bot_username

# Optional. Absolute site URL for Open Graph tags (on Vercel the production domain is used automatically).
# NEXT_PUBLIC_SITE_URL=https://example.com
